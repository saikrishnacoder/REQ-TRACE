# Copy to .env for local development. These values are development-only.
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-this-before-deploying
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DJANGO_CSRF_TRUSTED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Persistent hosted database. Never set this to SQLite in production.
SPECFORGE_DATABASE_URL=mysql://specforge:local-dev-password@127.0.0.1:3306/specforge
MYSQL_DATABASE=specforge
MYSQL_USER=specforge
MYSQL_PASSWORD=local-dev-password
MYSQL_ROOT_PASSWORD=local-dev-root-password
# Optional path to the MySQL CA certificate for TLS verification.
# MYSQL_SSL_CA=C:/path/to/mysql-ca.pem

# Production: set DJANGO_ENV=production and DJANGO_DEBUG=false. Provide
# explicit backend hostnames and HTTPS CORS/CSRF origins. Production requires
# MYSQL_SSL_CA and refuses SQLite.+# DJANGO_ENV=production
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<unique-long-secret>
# DJANGO_ALLOWED_HOSTS=api.example.com
# DJANGO_CORS_ALLOWED_ORIGINS=["https://app.example.com"]
# DJANGO_CSRF_TRUSTED_ORIGINS=["https://app.example.com"]
# MYSQL_SSL_CA=/run/secrets/mysql-ca.pem

DJANGO_MEDIA_ROOT=./media

# Optional server-side OpenAI-compatible application-generation provider.
# Generation fails closed unless both LLM_API_KEY and LLM_MODEL are set.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=
# LLM_REQUEST_TIMEOUT=120
