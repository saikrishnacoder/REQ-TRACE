# Desktop/offline mode uses a durable SQLite file under the current user's
# application data directory. Override REQTRACE_DATA_DIR to choose another path.
DATABASE_MODE=local

# Oracle-backed server/development mode. Set DATABASE_MODE=oracle to use this.
# Oracle XE 11g requires Thick mode and the Oracle Client libraries below.
ORACLE_USER=REQTRACE_APP
ORACLE_PASSWORD=replace-with-a-local-secret
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_SERVICE=XE
ORACLE_CLIENT_LIB_DIR=C:\oraclexe\app\oracle\product\11.2.0\server\bin
ORACLE_CONFIG_DIR=C:\oraclexe\app\oracle\product\11.2.0\server\network\admin

# Local API bind address. Keep the desktop sidecar on loopback.
API_HOST=127.0.0.1
API_PORT=8000

# Optional OpenAI-compatible analysis provider. Keep the key in this server-side
# environment file; it is never sent to the React client. Empty key uses the
# clearly labeled local heuristic fallback.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
