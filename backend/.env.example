# Desktop/offline mode uses a durable SQLite file under the current user's
# application data directory. Override REQTRACE_DATA_DIR to choose another path.
DATABASE_MODE=local

# PostgreSQL service mode. DATABASE_MODE=postgresql enables API authentication
# by default; configure AUTH_TOKEN_SECRET and bootstrap account values below.
# These values are ignored unless DATABASE_MODE=postgresql and DATABASE_URL is
# not set. The built-in adapter uses psycopg 3.
POSTGRES_USER=reqtrace
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=reqtrace
# Alternatively set DATABASE_URL=postgresql+psycopg://user:password@host:5432/db

# Oracle-backed server/development mode. Set DATABASE_MODE=oracle to use this.
# Oracle XE 11g requires Thick mode and the Oracle Client libraries below.
ORACLE_USER=REQTRACE_APP
ORACLE_PASSWORD=replace-with-a-local-secret
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_SERVICE=XE
ORACLE_CLIENT_LIB_DIR=C:\oraclexe\app\oracle\product\11.2.0\server\bin
ORACLE_CONFIG_DIR=C:\oraclexe\app\oracle\product\11.2.0\server\network\admin

# Local API bind address. Keep the desktop sidecar on loopback.
API_HOST=127.0.0.1
API_PORT=8000
# Add the deployed frontend origin(s) when hosting the UI separately.
CORS_ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000","http://tauri.localhost","tauri://localhost"]

# Oracle mode requires bearer authentication by default. Local mode keeps it
# disabled unless AUTH_REQUIRED=true. Set a random secret of at least 32
# characters and bootstrap the initial administrator once for authenticated mode.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-characters
AUTH_TOKEN_TTL_MINUTES=60
AUTH_BOOTSTRAP_EMAIL=admin@example.com
AUTH_BOOTSTRAP_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Optional OpenAI-compatible analysis provider. Keep the key in this server-side
# environment file; it is never sent to the React client. Empty key uses the
# clearly labeled local heuristic fallback.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional read-only GitHub fine-grained token (never exposed to the frontend).
# Grant repository metadata, contents, issues, and pull requests read access.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
